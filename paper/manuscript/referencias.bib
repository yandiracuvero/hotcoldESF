@article{ruhnau_eigenvector-centrality_2000,
	title = {Eigenvector-centrality — a node-centrality?},
	volume = {22},
	issn = {0378-8733},
	url = {https://www.sciencedirect.com/science/article/pii/S0378873300000319},
	doi = {10.1016/S0378-8733(00)00031-9},
	abstract = {Networks of social relations can be represented by graphs and socio-or adjacency-matrices and their structure can be analyzed using different concepts, one of them called centrality. We will provide a new formalization of a “node-centrality” which leads to some properties a measure of centrality has to satisfy. These properties allow to test given measures, for example measures based on degree, closeness, betweenness or Bonacich’s eigenvector-centrality. It turns out that it depends on normalization whether eigenvector-centrality does satisfy the expected properties or not.},
	pages = {357--365},
	number = {4},
	journaltitle = {Social Networks},
	shortjournal = {Social Networks},
	author = {Ruhnau, Britta},
	urldate = {2024-07-04},
	date = {2000-10-01},
}

